<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CatalogoFragmento" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/azul_ml</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/fondo_claro</item>
        <item name="android:textColorPrimary">@color/texto_principal</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
    </style>

    <style name="Theme.CatalogoFragmento" parent="Base.Theme.CatalogoFragmento" />

    <!-- Estilo de botón primario personalizado (modo oscuro) -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/azul_ml</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Estilo de botón tonal personalizado (modo oscuro) -->
    <style name="Widget.App.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/azul_tonal</item>
        <item name="android:textColor">@color/azul_ml</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>