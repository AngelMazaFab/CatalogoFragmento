<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/fondo_claro"
    tools:context=".FragmentCarrito">

    <TextView
        android:id="@+id/txtTituloCarrito"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛒 Carrito"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/texto_principal"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/lvCarrito"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="true"
        android:divider="@color/fondo_claro"
        android:dividerHeight="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/texto_secundario"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvTotalCarrito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total del carrito: $0.00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/azul_oscuro_ml"
        android:gravity="end"
        android:padding="8dp"
        android:background="@color/superficie" />

    <Button
        android:id="@+id/btnComprarCarrito"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="Comprar"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/azul_ml" />

</LinearLayout>
