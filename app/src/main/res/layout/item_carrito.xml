<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="@color/superficie">

    <ImageView
        android:id="@+id/imgCarritoItem"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        android:contentDescription="Imagen del artículo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/tvCarritoNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_principal"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvCarritoPrecioUnitario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp">

        <Button
            android:id="@+id/btnCarritoMenos"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="−"
            android:textSize="16sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <TextView
            android:id="@+id/tvCarritoCantidad"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/texto_principal"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCarritoMas"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="+"
            android:textSize="16sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvCarritoSubtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/azul_ml"
        android:textSize="14sp"
        android:textStyle="bold"
        android:minWidth="70dp"
        android:gravity="end" />

</LinearLayout>
